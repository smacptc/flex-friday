{
  // Flex Friday, deployed as a Worker that also serves the static site.
  "name": "flex-friday",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",

  // index.html is served straight from the edge. The icons are handled in worker.js.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Your database id is already filled in below. Do not replace this file with an
  // older copy, or the id goes missing and the deploy fails with error 10021.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flex-friday",
      "database_id": "5707012f-0ebc-4dd8-9236-664109b8c882"
    }
  ],

  // Live box scores. Cron times are UTC. These cover Sunday 1pm through the end of
  // Sunday night, Monday night, and Thursday night, all Eastern. Every minute while
  // a window is open; the Worker does nothing expensive when no game is in progress.
  "triggers": {
    "crons": [
      "* 17-23 * * 0",
      "* 0-4 * * 1",
      "* 0-4 * * 2",
      "* 0-4 * * 5"
    ]
  }
}
